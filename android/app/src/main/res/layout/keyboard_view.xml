<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboard_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/keyboard_bar_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <ImageButton
            android:id="@+id/btn_previous_ime"
            style="@style/KeyIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_key_round"
            android:contentDescription="@string/desc_switch_ime"
            android:src="@drawable/ic_keyboard" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="52dp">

            <LinearLayout
                android:id="@+id/status_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dot"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/label_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/chip_ready"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_chip"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_edit"
                android:drawableTint="?attr/colorOnPrimaryContainer"
                android:gravity="center_vertical"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="@string/chip_ready"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_settings"
            style="@style/KeyIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_key_round"
            android:contentDescription="@string/desc_settings"
            android:src="@drawable/ic_settings" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/mic_frame_size"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/key_touch_size"
            android:layout_height="@dimen/key_touch_size"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/btn_left"
                style="@style/KeyIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_key_round"
                android:contentDescription="@string/desc_cancel"
                android:src="@drawable/ic_close"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/badge_pending"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="@dimen/mic_frame_size"
            android:layout_height="@dimen/mic_frame_size"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:clipChildren="false">

            <View
                android:id="@+id/ring_0"
                android:layout_width="@dimen/mic_size"
                android:layout_height="@dimen/mic_size"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_ring" />

            <View
                android:id="@+id/ring_1"
                android:layout_width="@dimen/mic_size"
                android:layout_height="@dimen/mic_size"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_ring" />

            <ProgressBar
                android:id="@+id/progress_sending"
                style="?android:attr/progressBarStyle"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:indeterminateTint="?attr/colorPrimary"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/btn_mic"
                android:layout_width="@dimen/mic_size"
                android:layout_height="@dimen/mic_size"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic"
                android:clickable="true"
                android:contentDescription="@string/desc_mic"
                android:elevation="4dp"
                android:focusable="true">

                <ImageView
                    android:id="@+id/img_mic"
                    android:layout_width="@dimen/mic_icon_size"
                    android:layout_height="@dimen/mic_icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mic" />
            </FrameLayout>
        </FrameLayout>

        <com.example.whispertoinput.keyboard.BackspaceButton
            android:id="@+id/btn_backspace"
            style="@style/KeyIcon"
            android:layout_width="@dimen/key_touch_size"
            android:layout_height="@dimen/key_touch_size"
            android:background="@drawable/bg_key_round"
            android:contentDescription="@string/desc_backspace"
            android:src="@drawable/ic_backspace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_space"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_key_pill"
            android:contentDescription="@string/desc_space"
            android:gravity="center"
            android:text="@string/space_label"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_enter"
            style="@style/KeyIcon"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_key_enter"
            android:contentDescription="@string/desc_enter"
            android:src="@drawable/ic_return"
            app:tint="?attr/colorOnPrimaryContainer" />
    </LinearLayout>
</LinearLayout>
