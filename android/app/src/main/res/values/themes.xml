<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WhisperToInput" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand fallback palette; resolved per light/night configuration.
             Overridden by Material You dynamic color when available. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorSurfaceVariant">@color/brand_surface_variant</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="colorOnBackground">@color/brand_on_surface</item>
    </style>

    <style name="RegularImage">
        <item name="android:tint">@color/theme_rich_black</item>
    </style>

    <style name="RegularText">
        <item name="android:textColor">@color/theme_rich_black</item>
    </style>

    <style name="Background">
        <item name="android:background">@color/theme_light_grey</item>
    </style>

    <style name="TopBar">
        <item name="android:background">@color/theme_rich_black</item>
    </style>

    <!-- Settings Page Styles -->
    <style name="SettingsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SettingsDescription">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dark_gray</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">italic</item>
    </style>
    <style name="SettingsField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:inputType">textMultiLine</item>
    </style>
    <style name="SettingsSpinner">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Theme.WhisperToInput" parent="Base.Theme.WhisperToInput" />
</resources>