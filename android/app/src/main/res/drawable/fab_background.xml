<!-- FAB-style background for the mic button: primary circle (also provides the
     circular outline for the elevation shadow) with an on-primary press ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorOnPrimary">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorPrimary" />
        </shape>
    </item>
</ripple>
